  <Code><![CDATA[
$BigramBackupFolder_Load={
	#TODO: Initialize Form Controls here
	update-config
	

	
	$InstallDrive = $global:InstallDrive
	
	$DisplayMode = Get-RegValue -RegPath 'HKLM:\SOFTWARE\Wow6432Node\Visma\TeliaCygate' -RegName DisplayModeScript
	
	if ($DisplayMode -eq 'Light')
	{
		Set-ControlTheme -Control $BigramBackupFolder -Theme Light
	}
	
	elseif ($DisplayMode -eq 'Dark')
	{
		Set-ControlTheme -Control $BigramBackupFolder -Theme Dark
	}
	
	
	if (Test-Path "$global:InstallDrive\Visma\install\FDN\PIN\Client\Base\SW")
	{
		
		$global:FDNversion = Get-HighestFolderName -Path "$InstallDrive\Visma\install\FDN\PIN\Client\Base\SW"
	}
	else
	{
		$global:FDNversion = 'Download'
		
	}
	
	if (Test-Path "$global:InstallDrive\Visma\install\HRM\ppp")
	{
		$global:HRMversion = Get-HighestFolderName -Path "$InstallDrive\Visma\install\HRM" -Recurse
	}
	else
	{
		$global:HRMversion = 'Download'
	}
	
	if (Test-Path "$InstallDrive\Visma\install\hrm\ppp\DatabaseServer\Script\SW")
	{
		$global:PPPversion = Get-HighestFolderName -Path "$InstallDrive\Visma\install\hrm\ppp\DatabaseServer\Script\SW" -Recurse
	}
	else
	{
		$global:PPPversion = 'Download'
	}
	
	if (Test-Path "$InstallDrive\Visma\install\hrm\PUD\DatabaseServer\Script\SW")
	{
		$global:PUDversion = Get-HighestFolderName -Path "$InstallDrive\Visma\install\hrm\PUD\DatabaseServer\Script\SW" -Recurse
	}
	else
	{
		$global:PUDversion = 'Download'
	}
	if (Test-Path "$InstallDrive\Visma\install\HRM\PFH\DatabaseServer\Script\SW")
	{
		$global:PFHversion = Get-HighestFolderName -Path "$InstallDrive\Visma\install\HRM\PFH\DatabaseServer\Script\SW" -Recurse
	}
	else
	{
		$global:PFHversion = 'Download'
	}

	
	Refresh-StatusBar
	
	$buttonDeleteFolder.Enabled = $false
	$buttonCreateFolder.Enabled = $false
	$buttonSaveBigram.Enabled = $false
	$buttonCreateFolder.Enabled = $false
	$buttonDeleteBigram.Enabled = $false
	
	

}

$BigramBackupFolder.add_FormClosing(
	{
		

		$InstallDrive = $global:InstallDrive
		$BIGRAM_XML = $TB_Bigram.text

		
		
		$SavePathExist = Test-Path -Path "$InstallDrive\Visma\install\backup\AppSettings"
		
		if ($SavePathExist -eq $false)
		{
			New-Item -Path "$InstallDrive\Visma\install\backup\Appsettings" -ItemType Directory
		}
		
		#Create XML BIGRAM
		$xmlWriter = New-Object System.XMl.XmlTextWriter("$installdrive\Visma\install\backup\Appsettings\$BIGRAM_XML.XML", $null)
		$xmlWriter.Formatting = 'Indented'
		$xmlWriter.Indentation = 1
		$XmlWriter.IndentChar = "`t"
		
		$xmlWriter.WriteStartDocument()
		
		$xmlWriter.WriteStartElement("Configuration") # Configuration Startnode
		
		$xmlWriter.WriteElementString("ConfigVersion", "1.0")
		$xmlWriter.WriteElementString("CustomerBigram", "$BIGRAM_XML")
		$xmlWriter.WriteElementString("InstallDrive", "$InstallDrive")
		$xmlWriter.WriteEndElement() # Configuration endnode
		$xmlWriter.Flush()
		$xmlWriter.Close()
		
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("CREATED/Updated instance: $BIGRAM_XML")
		$richtextbox1.AppendText("`n")
		$richtextbox1.ScrollToCaret()
		Write-Log -Level INFO -Message "Created/Updated instance: $BIGRAM_XML"
		
		#Create XML VERSION
		#$xmlWriter = New-Object System.XMl.XmlTextWriter("$installdrive\Visma\install\backup\Appsettings\Version.XML", $null)
		#$xmlWriter.Formatting = 'Indented'
		#$xmlWriter.Indentation = 1
		#$XmlWriter.IndentChar = "`t"
		
		#$xmlWriter.WriteStartDocument()
		
		#$xmlWriter.WriteStartElement("Configuration") # Configuration Startnode
		
		#$xmlWriter.WriteElementString("ConfigVersion", "1.0")
		#$xmlWriter.WriteElementString("VPBSVersion_1", "$VPBSVERSION_1")
		#$xmlWriter.WriteElementString("VPBSVersion_2", "$VPBSVERSION_2")
		#$xmlWriter.WriteElementString("FDNVersion", "$FDNReleaseVersion_XML")
		#$xmlWriter.WriteElementString("HRMVersion", "$HRMReleaseVersion_XML")
		#$xmlWriter.WriteElementString("PPP", "$DB_PPP_XML")
		#$xmlWriter.WriteElementString("PUD", "$DB_PUD_XML")
		#$xmlWriter.WriteElementString("PFH", "$DB_PFH_XML")
		#$xmlWriter.WriteEndElement() # Configuration endnode
		#$xmlWriter.Flush()
		#$xmlWriter.Close()
		
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("CREATED/Updated instance: $BIGRAM_XML")
		$richtextbox1.AppendText("`n")
		$richtextbox1.ScrollToCaret()
		update-config
		
	}
	
)


#endregion

$BigramListBox_SelectedIndexChanged={
	#TODO: Place custom script here
	$buttonDeleteBigram.Enabled = $true
	$buttonSaveBigram.Enabled = $true
	$file = $BigramListBox.selecteditem
	
	[XML]$xmlValues = Get-Content "$global:InstallDrive\Visma\install\backup\appsettings\$file.XML"
	#[XML]$xmlValuesVersion = Get-Content "$global:InstallDrive\Visma\install\backup\appsettings\Version.XML"
	
	$bigramValue = $xmlValues.configuration.CustomerBigram

	
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("Selected Bigram: $bigramValue")
	$richtextbox1.ScrollToCaret()
	

	Write-Log -Level INFO -Message "Selected Bigram: $bigramValue"

	$TB_Bigram.Clear()
	$TB_Bigram.AppendText($bigramValue)
	
	$global:SelectedBigram = $bigramValue
	
	$StatusBar.Text = 'Bigram:' + $global:SelectedBigram + ' BackupFolder:' + $global:SelectedBackupfolder
	
	
	
	}

$buttonSaveBigram_Click={
	$InstallDrive = $global:InstallDrive
	$BIGRAM_XML = $TB_Bigram.text
	
	$SavePathExist = Test-Path -Path "$InstallDrive\Visma\install\backup\AppSettings"
	
	if ($SavePathExist -eq $false)
	{
		New-Item -Path "$InstallDrive\Visma\install\backup\Appsettings" -ItemType Directory
	}
	
	#Create XML BIGRAM
	$xmlWriter = New-Object System.XMl.XmlTextWriter("$installdrive\Visma\install\backup\Appsettings\$BIGRAM_XML.XML", $null)
	$xmlWriter.Formatting = 'Indented'
	$xmlWriter.Indentation = 1
	$XmlWriter.IndentChar = "`t"
	
	$xmlWriter.WriteStartDocument()
	
	$xmlWriter.WriteStartElement("Configuration") # Configuration Startnode
	
	$xmlWriter.WriteElementString("ConfigVersion", "1.0")
	$xmlWriter.WriteElementString("CustomerBigram", "$BIGRAM_XML")
	$xmlWriter.WriteElementString("InstallDrive", "$InstallDrive")
	$xmlWriter.WriteEndElement() # Configuration endnode
	$xmlWriter.Flush()
	$xmlWriter.Close()
	
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("CREATED/Updated instance: $BIGRAM_XML")
	$richtextbox1.AppendText("`n")
	$richtextbox1.ScrollToCaret()
	Write-Log -Level INFO -Message "Created/Updated instance: $BIGRAM_XML"
	
	
	

	update-config
	
	
}

$buttonClose_Click={
	#TODO: Place custom script here
	
	Refresh-StatusBarMain
	
	
	$BigramBackupFolder.Close()
}


$BigramBackupFolder.add_Closing(
	{
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("*******************************")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("Versions downloaded on server:")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("FDN version on server: $global:FDNversion")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("HRM version on server: $global:HRMversion")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("PPP version on server: $global:PPPversion")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("PUD version on server: $Global:PUDversion")
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("PFH version on server: $Global:PFHversion")
		$richtextbox1.AppendText("`n")
		$richtextbox1.ScrollToCaret()
	}
)



$buttonDeleteFolder_Click={
	#TODO: Place custom script here
	
	$folderToDelete = $BackupFolderListbox.SelectedItem
	$InstallDrive = $global:InstallDrive
	$selectedBackupfolder = $global:SelectedBackupfolder
	$selectedBigram = $global:SelectedBigram
	

	
	Add-Type -AssemblyName PresentationCore, PresentationFramework
	$ButtonType = [System.Windows.MessageBoxButton]::YesNo
	$MessageIcon = [System.Windows.MessageBoxImage]::Information
	$MessageBody = "Do you want to delete $folderToDelete with all files and folders?"
	$MessageTitle = "Delete backupfolder"
	
	$Result = [System.Windows.MessageBox]::Show($MessageBody, $MessageTitle, $ButtonType, $MessageIcon)
	
	if ($Result -eq [System.Windows.MessageBoxResult]::Yes)
	{
		
		$source = "$InstallDrive\visma\install\backup\$folderToDelete\"
		$richtextbox1.AppendText("Deleting: $source")
		$richtextbox1.AppendText("`n")
		$richtextbox1.ScrollToCaret()
		
		Remove-Item -Path $source -Recurse -Force -ErrorAction SilentlyContinue

		Write-Log -Level INFO -Message "Backupfolder $folder removed"
		update-config
	}
}

$buttonCreateFolder_Click={
	#TODO: Place custom script here
	$foldername = $TB_BackupfolderName.Text
	$InstallDrive = $global:InstallDrive
	$richtextbox1.AppendText("New Backupfolder created: $foldername")
	$richtextbox1.AppendText("`n")
	$richtextbox1.ScrollToCaret()
	
	New-Item -Path "$InstallDrive\visma\install\backup\$foldername" -ItemType directory
	
	Write-Log -Level INFO -Message "New Backupfolder created: $foldername"
	
	update-config
}

$BackupFolderListbox_SelectedIndexChanged={
	#TODO: Place custom script here
	$buttonDeleteFolder.Enabled = $true
	$selectedItems = $BackupFolderListbox.SelectedItems
	
	$Backupfolder = $BackupFolderListbox.SelectedItem
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("Selected backupfolder: $Backupfolder")
	Write-Log -Level INFO -Message "Selected backupfolder: $Backupfolder"
	$richtextbox1.ScrollToCaret()

	$global:SelectedBackupfolder = $Backupfolder
	
	$StatusBar.Text = 'Bigram:' + $global:SelectedBigram + ' BackupFolder:' + $global:SelectedBackupfolder
}

$buttonDeleteBigram_Click={
	#TODO: Place custom script here
	$selectedBigram = $global:SelectedBigram
	$InstallDrive = $global:InstallDrive
	
	Add-Type -AssemblyName PresentationCore, PresentationFramework
	$ButtonType = [System.Windows.MessageBoxButton]::YesNo
	$MessageIcon = [System.Windows.MessageBoxImage]::Information
	$MessageBody = "Do you want to delete $selectedBigram"
	$MessageTitle = "Delete Bigram File"
	
	$Result = [System.Windows.MessageBox]::Show($MessageBody, $MessageTitle, $ButtonType, $MessageIcon)
	
	if ($Result -eq [System.Windows.MessageBoxResult]::Yes)
	{
		
		$source = "$InstallDrive\visma\install\backup\appsettings\$selectedBigram.XML"
		$richtextbox1.AppendText("Deleting: $source")
		$richtextbox1.AppendText("`n")
		$richtextbox1.ScrollToCaret()
		
		Remove-Item -Path $source -Force -ErrorAction SilentlyContinue
		
		Write-Log -Level INFO -Message "Bigram $selectedBigram removed"
		Write-Log -Level INFO -Message "path $source"
		update-config
	}
}

$TB_BackupfolderName_TextChanged={
	#TODO: Place custom script here
	$buttonCreateFolder.Enabled = $true
}

$TB_Bigram_TextChanged={
	#TODO: Place custom script here
	$buttonSaveBigram.Enabled = $true
}
]]></Code>
