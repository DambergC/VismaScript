  <Code><![CDATA[
$TLScheck_Load={
	#TODO: Initialize Form Controls here
	If ($global:SelectedBigram -eq 'Select Bigram' -or $global:SelectedBackupfolder -eq 'Select Folder')
	{
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("You Need to select BIGRAM and BackupFolder")
		$richtextbox1.ScrollToCaret()
		$TLScheck.Close()
	}
	
	$DisplayMode = Get-RegValue -RegPath 'HKLM:\SOFTWARE\Wow6432Node\Visma\TeliaCygate' -RegName DisplayModeScript
	
	if ($DisplayMode -eq 'Light')
	{
		Set-ControlTheme -Control $TLScheck -Theme Light
	}
	
	elseif ($DisplayMode -eq 'Dark')
	{
		Set-ControlTheme -Control $TLScheck -Theme Dark
	}
}

$buttonRunCheck_Click={
	#TODO: Place custom script here
	# Check TLS 1.2 settings
	$regPathTLS12Server = "HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\TLS 1.2\Server"
	$regPathTLS12Client = "HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\TLS 1.2\Client"
	$regPathTLS11Server = "HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\TLS 1.1\Server"
	$regPathTLS11Client = "HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\TLS 1.1\Client"
	$regPathTLS10Server = "HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\TLS 1.0\Server"
	$regPathTLS10Client = "HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\TLS 1.0\Client"
	
	$TLS12ServerEnabled = Get-RegValue -RegPath $regPathTLS12Server -RegName "Enabled"
	$TLS12ClientEnabled = Get-RegValue -RegPath $regPathTLS12Client -RegName "Enabled"
	$TLS11ServerEnabled = Get-RegValue -RegPath $regPathTLS11Server -RegName "Enabled"
	$TLS11ClientEnabled = Get-RegValue -RegPath $regPathTLS11Client -RegName "Enabled"
	$TLS10ServerEnabled = Get-RegValue -RegPath $regPathTLS10Server -RegName "Enabled"
	$TLS10ClientEnabled = Get-RegValue -RegPath $regPathTLS10Client -RegName "Enabled"
	
	#Write-Output "TLS 1.2 Server Enabled: $TLS12ServerEnabled"
	#Write-Output "TLS 1.2 Client Enabled: $TLS12ClientEnabled"
	
	## 1.2
	if ($TLS12ClientEnabled -eq '4294967295' -or $TLS12ClientEnabled -eq '1')
	{
		$TLS12Client.Image = $Trafficlight.Images[2]
	}
	else
	{
		$TLS12Client.Image = $Trafficlight.Images[0]
	}
	
	if ($TLS12ServerEnabled -eq '4294967295' -or $TLS12ServerEnabled -eq '1')
	{
		$TLS12Server.Image = $Trafficlight.Images[2]
	}
	else
	{
		$TLS12Server.Image = $Trafficlight.Images[0]
	}
	
	## 1.1
	if ($TLS11ClientEnabled -eq '4294967295' -or $TLS11ClientEnabled -eq '1')
	{
		$TLS11Client.Image = $Trafficlight.Images[2]
	}
	else
	{
		$TLS11Client.Image = $Trafficlight.Images[0]
	}
	
	if ($TLS11ServerEnabled -eq '4294967295' -or $TLS11ServerEnabled -eq '1')
	{
		$TLS11Server.Image = $Trafficlight.Images[2]
	}
	else
	{
		$TLS11Server.Image = $Trafficlight.Images[0]
	}
	
	## 1.0
	if ($TLS10ClientEnabled -eq '4294967295' -or $TLS10ClientEnabled -eq '1')
	{
		$TLS10Client.Image = $Trafficlight.Images[2]
	}
	else
	{
		$TLS10Client.Image = $Trafficlight.Images[0]
	}
	
	if ($TLS11ServerEnabled -eq '4294967295' -or $TLS11ServerEnabled -eq '1')
	{
		$TLS10Server.Image = $Trafficlight.Images[2]
	}
	else
	{
		$TLS10Server.Image = $Trafficlight.Images[0]
	}
	
	# Check if common IIS Crypto settings are applied
	$regPathSCHANNEL = "HKLM:\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL"
	$bestPracticesApplied = $false
	
	# Check for common best practices settings
	$protocols = @("TLS 1.0", "TLS 1.1", "SSL 2.0", "SSL 3.0")
	foreach ($protocol in $protocols)
	{
		$keyPath = "$regPathSCHANNEL\Protocols\$protocol\Server"
		$enabled = Get-RegValue -RegPath $keyPath -RegName "Enabled"
		if ($enabled -eq 0)
		{
			$bestPracticesApplied = $true
		}
	}
	
	if ($bestPracticesApplied)
	{
		#Write-Output "IIS Crypto Best Practices or Strict settings are likely applied."
		
		$IISCrypto.Image = $Trafficlight.Images[2]
		
	}
	else
	{
		#Write-Output "IIS Crypto Best Practices or Strict settings are not detected."
		$IISCrypto.Image = $Trafficlight.Images[0]
	}
	
	# Check .NET Framework SystemDefaultTlsVersions settings
	$regPathDotNetFramework = "HKLM:\SOFTWARE\Microsoft\.NETFramework\v4.0.30319"
	$regPathDotNetFrameworkWow6432 = "HKLM:\SOFTWARE\Wow6432Node\Microsoft\.NETFramework\v4.0.30319"
	
	$dotNetFrameworkTLS = Get-RegValue -RegPath $regPathDotNetFramework -RegName "SystemDefaultTlsVersions"
	$dotNetFrameworkTLSWow6432 = Get-RegValue -RegPath $regPathDotNetFrameworkWow6432 -RegName "SystemDefaultTlsVersions"
	
	#Write-Output ".NET Framework SystemDefaultTlsVersions (64-bit): $dotNetFrameworkTLS"
	#Write-Output ".NET Framework SystemDefaultTlsVersions (32-bit): $dotNetFrameworkTLSWow6432"
	
	#$regpathtest = Test-Path 'HKLM:\SOFTWARE\Microsoft\.NETFramework\v4.0.30319\SystemDefaultTlsVersions'
	#$regpathtest64 = Test-Path 'HKLM:\SOFTWARE\Wow6432Node\Microsoft\.NETFramework\v4.0.30319\SystemDefaultTlsVersions'
	
	
	if ($dotNetFrameworkTLS -eq '1')
	{
		$TLSRegFix32.Image = $Trafficlight.Images[2]
	}
	
	else
	{
		$TLSRegFix32.Image = $Trafficlight.Images[0]
	}
	
	if ($dotNetFrameworkTLSWow6432 -eq '1')
	{
		$TLSRegFix64.Image = $Trafficlight.Images[2]
	}
	
	else
	{
		$TLSRegFix64.Image = $Trafficlight.Images[0]
	}
}

$buttonClose_Click={
	#TODO: Place custom script here
	
	$TLScheck.Close()
}
]]></Code>
