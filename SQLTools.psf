$buttonCompabilityLevel_Click={
	#TODO: Place custom script here
	$selectedBigram = $global:SelectedBigram
	
	$SQLCORE = $SelectedBigram + '_Core'
	$SQLNEPTUNE =$SelectedBigram + '_Neptune'
	$SQLPAG = $SelectedBigram + '_PAG'
	$SQLPPP = $SelectedBigram + '_PPP'
	$SQLPFH = $SelectedBigram + '_PFH'
	$SQLPUD = $SelectedBigram + '_PUD'
	$SQLQUICKREPORT = $SelectedBigram + '_Quickreport'
	
	
	$BigramXMLFile = $SelectedBigram + "_applications.xml"
	[xml]$xml = (Get-Content "$global:InstallDrive\Visma\Install\FDN\pin\Client\Base\SW\$global:PINversion\$BigramXMLFile" -Raw) -replace '[^\u0009\u000A\u000D\u0020-\u007E]', ''
	
	$databaseserver = $xml.Applications.InstanceCommon.Parameters.DatabaseServer
	$databaseusername = $xml.Applications.InstanceCommon.Parameters.DatabaseServerUser
	$databaseuserpassword = $xml.Applications.InstanceCommon.Parameters.DatabaseServerUserPassword
	
	$PPPDatabase = $SelectedBigram + "_PPP"
	
	
	
	$sqlqueryVersion = @"
SELECT 
    name AS [DatabaseName], 
    compatibility_level,
    CASE compatibility_level
        WHEN 80  THEN 'SQL Server 2000'
        WHEN 90  THEN 'SQL Server 2005'
        WHEN 100 THEN 'SQL Server 2008'
        WHEN 110 THEN 'SQL Server 2012'
        WHEN 120 THEN 'SQL Server 2014'
        WHEN 130 THEN 'SQL Server 2016'
        WHEN 140 THEN 'SQL Server 2017'
        WHEN 150 THEN 'SQL Server 2019'
        WHEN 160 THEN 'SQL Server 2022'
        ELSE 'Unknown'
    END AS [SQLServerVersion]
FROM 
    sys.databases
WHERE 
    name IN ('$SQLCORE', '$SQLNEPTUNE', '$SQLPAG','$SQLPPP','$SQLPFH','$SQLPUD','$SQLQUICKREPORT','Visma_Commonstorage','Visma_currency','Visma_Messenger','Visma_Scheduler');
"@
	
	$richtextbox1.AppendText("Check Compability level")
	$richtextbox1.AppendText("`n")
	
	
	
	$resultat = Invoke-Sqlcmd -ServerInstance $databaseserver -Database $pppDatabase -Query $sqlqueryVersion -Username $databaseusername -Password $databaseuserpassword -TrustServerCertificate | Out-String
	$richtextbox1.AppendText("$resultat")
	$richtextbox1.AppendText("`n")
	$richtextbox1.ScrollToCaret()
}

$buttonBackupLastDurationSi_Click={
	#TODO: Place custom script here
	#TODO: Place custom script here
	$selectedBigram = $global:SelectedBigram
	
	$SQLCORE = $SelectedBigram + '_Core'
	$SQLNEPTUNE = $SelectedBigram + '_Neptune'
	$SQLPAG = $SelectedBigram + '_PAG'
	$SQLPPP = $SelectedBigram + '_PPP'
	$SQLPFH = $SelectedBigram + '_PFH'
	$SQLPUD = $SelectedBigram + '_PUD'
	$SQLQUICKREPORT = $SelectedBigram + '_Quickreport'
	
	
	$BigramXMLFile = $SelectedBigram + "_applications.xml"
	[xml]$xml = (Get-Content "$global:InstallDrive\Visma\Install\FDN\pin\Client\Base\SW\$global:PINversion\$BigramXMLFile" -Raw) -replace '[^\u0009\u000A\u000D\u0020-\u007E]', ''
	
	$databaseserver = $xml.Applications.InstanceCommon.Parameters.DatabaseServer
	$databaseusername = $xml.Applications.InstanceCommon.Parameters.DatabaseServerUser
	$databaseuserpassword = $xml.Applications.InstanceCommon.Parameters.DatabaseServerUserPassword
	
	$PPPDatabase = $SelectedBigram + "_PPP"
	
	
	
	
	$sqlqueryVersion = @"
SELECT
    d.name AS DatabaseName,
    CONVERT(VARCHAR(16), lastb.backup_start_date, 120) AS StartTime,  -- yyyy-mm-dd hh:mi
    ROUND(CONVERT(FLOAT, ISNULL(lastb.backup_size, 0)) / 1024 / 1024, 2) AS BackupSizeMB,
    -- Duration as H:MM:SS (hours may be >2 digits)
    CAST(DATEDIFF(SECOND, lastb.backup_start_date, lastb.backup_finish_date) / 3600 AS VARCHAR(10)) + ':' +
    RIGHT('00' + CAST((DATEDIFF(SECOND, lastb.backup_start_date, lastb.backup_finish_date) % 3600) / 60 AS VARCHAR(2)), 2) + ':' +
    RIGHT('00' + CAST(DATEDIFF(SECOND, lastb.backup_start_date, lastb.backup_finish_date) % 60 AS VARCHAR(2)), 2) AS Duration_HHMMSS
FROM sys.databases d
OUTER APPLY (
    SELECT TOP (1)
        b.backup_start_date,
        b.backup_finish_date,
        b.backup_size
    FROM msdb.dbo.backupset b
    WHERE b.database_name = d.name
    ORDER BY b.backup_finish_date DESC
) lastb

WHERE 
    name IN ('$SQLCORE', '$SQLNEPTUNE', '$SQLPAG','$SQLPPP','$SQLPFH','$SQLPUD','$SQLQUICKREPORT','Visma_Commonstorage','Visma_currency','Visma_Messenger','Visma_Scheduler');
"@
	
	$richtextbox1.AppendText("Databasebackup - Last - Size - Duration")
	$richtextbox1.AppendText("`n")
	
	
	
	$resultat = Invoke-Sqlcmd -ServerInstance $databaseserver -Database $pppDatabase -Query $sqlqueryVersion -Username $databaseusername -Password $databaseuserpassword -TrustServerCertificate | Out-String
	$richtextbox1.AppendText("$resultat")
	$richtextbox1.AppendText("`n")
	$richtextbox1.ScrollToCaret()
}

