	Remove-PersonecFolders -Path "$global:InstallDrive\visma\wwwroot\$global:SelectedBigram\PPP" -ExcludedFolders 'Personec_AG', 'Personec_P_Web', 'Personec_P_FMRwebb', 'Services', 'Personec_P_Integration_Services', 'P Mobile', 'P Manager Mobile'
	Remove-PersonecFolders -Path "$global:InstallDrive\visma\wwwroot\$global:SelectedBigram\PPP\Personec_AG" -ExcludedFolders 'CR'
	Remove-PersonecFolders -Path "$global:InstallDrive\visma\wwwroot\$global:SelectedBigram\PPP\Personec_AG\CR" -ExcludedFolders 'rpt'
	Remove-PersonecFolders -Path "$global:InstallDrive\visma\wwwroot\$global:SelectedBigram\PPP\Personec_P_Web" -ExcludedFolders 'Lon'
	Remove-PersonecFolders -Path "$global:InstallDrive\visma\wwwroot\$global:SelectedBigram\PPP\Personec_P_Web\Lon" -ExcludedFolders 'CR'
	Remove-PersonecFolders -Path "$global:InstallDrive\visma\wwwroot\$global:SelectedBigram\PPP\Personec_P_Web\Lon\CR" -ExcludedFolders 'rpt'
}

$buttonInetpubLogs_Click={
	#TODO: Place custom script here
	Add-Type -AssemblyName PresentationCore, PresentationFramework
	
	# Define the message box parameters
	$ButtonType = [System.Windows.MessageBoxButton]::YesNo
	$MessageIcon = [System.Windows.MessageBoxImage]::Information
	$MessageBody = "Do you want to clean up the logfiles under inetpub\logs\logfiles"
	$MessageTitle = "Clean up Install-folder"
	
	# Show the message box
	$Result = [System.Windows.MessageBox]::Show($MessageBody, $MessageTitle, $ButtonType, $MessageIcon)
	
	# Check the result
	if ($Result -eq [System.Windows.MessageBoxResult]::Yes)
	{
		Remove-LogFiles
	}
	
	else
	{
		$richtextbox1.AppendText("Delete of inetpub logs cancelled`n")
	}
}



