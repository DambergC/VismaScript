  <Code><![CDATA[
$formCleanUp_Load={
	#TODO: Initialize Form Controls here
	Refresh-StatusBar
	
	$DisplayMode = Get-RegValue -RegPath 'HKLM:\SOFTWARE\Wow6432Node\Visma\TeliaCygate' -RegName DisplayModeScript
	
	if ($DisplayMode -eq 'Light')
	{
		Set-ControlTheme -Control $formCleanUp -Theme Light
	}
	
	elseif ($DisplayMode -eq 'Dark')
	{
		Set-ControlTheme -Control $formCleanUp -Theme Dark
	}
	
	If ($global:SelectedBigram -eq 'Select Bigram' -or $global:SelectedBackupfolder -eq 'Select Folder')
	{
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("You Need to select BIGRAM and BackupFolder")
		$richtextbox1.ScrollToCaret()
		$formCleanUp.Close()
	}
	
	# check if folder exist
	$pmobilepath = (Test-Path "$global:InstallDrive\Visma\wwwroot\$global:SelectedBigram\PPP\P Mobile")
	$pmobileMGRpath = (Test-Path "$global:InstallDrive\Visma\wwwroot\$global:SelectedBigram\PPP\P Manager Mobile")
	$FMRpath = (Test-Path "$global:InstallDrive\Visma\wwwroot\$global:SelectedBigram\PPP\Personec_P_FMRwebb")
	$PISpath = (Test-Path "$global:InstallDrive\Visma\wwwroot\$global:SelectedBigram\PPP\Personec_P_Integration_Services")
	$PAGpath = (Test-Path "$global:InstallDrive\Visma\wwwroot\$global:SelectedBigram\PPP\Personec_AG")
	$PFApath = (Test-Path "$global:InstallDrive\Visma\wwwroot\$global:SelectedBigram\PFA")
	$PFHpath = (Test-Path "$global:InstallDrive\Visma\wwwroot\$global:SelectedBigram\PFH")
	$PIApath = (Test-Path "$global:InstallDrive\Visma\wwwroot\$global:SelectedBigram\PIA")
	$PIPpath = (Test-Path "$global:InstallDrive\Visma\wwwroot\$global:SelectedBigram\PIP")
	$PUDpath = (Test-Path "$global:InstallDrive\Visma\wwwroot\$global:SelectedBigram\PUD")
	$PIPpath = (Test-Path "$global:InstallDrive\Visma\wwwroot\$global:SelectedBigram\PIP")

	
	if (Is-ApplicationInstalled -AppName "Personec P AG - $global:SelectedBigram")
	{
		$buttonPAGWeb.Enabled = $false
	}
	else
	{
		$buttonPAGWeb.Enabled = $true
	}
	
	
	
	if (Is-ApplicationInstalled -AppName "Personec P Forhandling webadmin - $global:SelectedBigram" -Manufacturer 'visma')
	{
		$buttonPFHWebAdmin.Enabled = $false
	}
	else
	{
		$buttonPFHWebAdmin.Enabled = $true
	}

	

	if (Is-ApplicationInstalled -AppName "Personec P Integration API - $global:SelectedBigram" -Manufacturer 'visma')
	{
		$buttonPIP.Enabled = $false
	}
	else
	{
		$buttonPIP.Enabled = $true
	}

	

	if (Is-ApplicationInstalled -AppName "Personec P Utdata plus - $global:SelectedBigram" -Manufacturer 'visma')
	{
		$buttonPUDWeb.Enabled = $false
	}
	else
	{
		$buttonPUDWeb.Enabled = $true
	}

	if (Is-ApplicationInstalled -AppName "Visma Personec P Web Server - $global:SelectedBigram" -Manufacturer 'visma')
	{
		$buttonPPPWeb.Enabled = $false
	}
	else
	{
		$buttonPPPWeb.Enabled = $true
	}
	if (Is-ApplicationInstalled -AppName "Personec P Forhandling Web - $global:SelectedBigram" -Manufacturer 'visma')
	{
		$buttonPFHWin.Enabled = $false
	}
	else
	{
		$buttonPFHWin.Enabled = $true
	}
	if (Is-ApplicationInstalled -AppName "Personec P Utdata Win - $global:SelectedBigram" -Manufacturer 'visma')
	{
		$buttonPUDWin.Enabled = $false
	}
	else
	{
		$buttonPUDWin.Enabled = $true
	}
	if (Is-ApplicationInstalled -AppName "Personec P Win - $global:SelectedBigram" -Manufacturer 'visma')
	{
		$buttonPPPWin.Enabled = $false
	}
	else
	{
		$buttonPPPWin.Enabled = $true
	}
	if (Is-ApplicationInstalled -AppName "Personec Information Authorization Service - $global:SelectedBigram" -Manufacturer 'visma')
	{
		$buttonPAAWin.Enabled = $false
	}
	else
	{
		$buttonPAAWin.Enabled = $true
	}
	if (Is-ApplicationInstalled -AppName "Personec P Background Service - $global:SelectedBigram" -Manufacturer 'visma')
	{
		$buttonPBSWin.Enabled = $false
	}
	else
	{
		$buttonPBSWin.Enabled = $true
	}
	if (Is-ApplicationInstalled -AppName "Login - $global:SelectedBigram" -Manufacturer 'visma')
	{
		$buttonVIW.Enabled = $false
	}
	else
	{
		$buttonVIW.Enabled = $true
	}
	
	# Test if webb
	$ISWebserver = Test-WebServer
	
	
	if ($ISWebServer -eq $true )
	{
		$buttonInetpubLogs.Enabled = $true
		$buttonTempASPnet.Enabled = $true
	}
	
	else
	{
		$buttonInetpubLogs.Enabled = $false
		$buttonTempASPnet.Enabled = $false
	}

}

$buttonTempASPnet_Click={
	#TODO: Place custom script here
	
	$aspNetPath = "C:\Windows\Microsoft.NET\Framework\v4.0.30319\Temporary ASP.NET Files"
	
	$aspNet64Path = "C:\Windows\Microsoft.NET\Framework64\v4.0.30319\Temporary ASP.NET Files"
	
	Add-Type -AssemblyName PresentationCore, PresentationFramework
	
	# Define the message box parameters
	$ButtonType = [System.Windows.MessageBoxButton]::YesNo
	$MessageIcon = [System.Windows.MessageBoxImage]::Information
	$MessageBody = "Do you want to delete Asp.NET Tempfiles?`n$aspNetPath`n$aspNet64Path"
	$MessageTitle = "Delete ASP .Net Temp Files"
	
	# Show the message box
	$Result = [System.Windows.MessageBox]::Show($MessageBody, $MessageTitle, $ButtonType, $MessageIcon)
	
	# Check the result
	if ($Result -eq [System.Windows.MessageBoxResult]::Yes)
	{
		# Update the text of the existing RichTextBox
		$CleanUpTextBox.Text = "Deleting files..."
		
		$CleanUpTextBox.AppendText("`n")
		$CleanUpTextBox.AppendText("Deleting files...")
		$CleanUpTextBox.AppendText("`n")
		$CleanUpTextBox.AppendText("$aspNetPath")
		Write-LogCleanup -Level INFO -Message "$aspNetPath files deleted"
		$CleanUpTextBox.ScrollToCaret()
		Remove-PersonecFolders -Path $aspNetPath
		
		$CleanUpTextBox.AppendText("`n")
		$CleanUpTextBox.AppendText("Deleting files...")
		$CleanUpTextBox.AppendText("`n")
		$CleanUpTextBox.AppendText("$aspNet64Path")
		Write-LogCleanup -Level INFO -Message "$aspNet64Path files deleted"
		$CleanUpTextBox.ScrollToCaret()
		Remove-PersonecFolders -Path $aspNet64Path
	}
	else
	{
		# Update the text of the existing RichTextBox
		$CleanUpTextBox.Text = "Files not deleted."
		Write-LogCleanup -Level INFO -Message "ASP.NET Files not Deleted"
	}
	
	

	
}

$buttonInstallCatalog2_Click={
	#TODO: Place custom script here
	
	Add-Type -AssemblyName PresentationCore, PresentationFramework
	
	# Define the message box parameters
	$ButtonType = [System.Windows.MessageBoxButton]::YesNo
	$MessageIcon = [System.Windows.MessageBoxImage]::Information
	$MessageBody = "Do you want to clean up the $global:InstallDrive\Visma\Install folder?"
	$MessageTitle = "Clean up Install-folder"
	
	# Show the message box
	$Result = [System.Windows.MessageBox]::Show($MessageBody, $MessageTitle, $ButtonType, $MessageIcon)
	
	# Check the result
	if ($Result -eq [System.Windows.MessageBoxResult]::Yes)
	{
		$supportFolder = (Test-Path "$global:InstallDrive\Visma\install\Support")
		
		if ($supportFolder -eq $true)
		{
			Remove-Item -Path "$global:InstallDrive\Visma\install\Support" -Recurse -Force -ErrorAction SilentlyContinue
			$CleanupTextBox.AppendText("Support under install removed")
			Write-LogCleanup -Level INFO -Message "Support under install removed"
			$CleanupTextBox.AppendText("`n")
			$cleanupTextBox.ScrollToCaret()
		}
		
		else
		{
			$CleanupTextBox.AppendText("Support does not exist under install")
			Write-LogCleanup -Level INFO -Message "Support under install removed"
			$CleanupTextBox.AppendText("`n")
			$cleanupTextBox.ScrollToCaret()
		}
		
		$SAPFolder = (Test-Path "$global:InstallDrive\Visma\install\SAP")
		
		if ($SAPFolder -eq $true)
		{
			Remove-Item -Path "$global:InstallDrive\Visma\install\SAP" -Recurse -Force -ErrorAction SilentlyContinue
			$CleanupTextBox.AppendText("SAP under install removed")
			Write-LogCleanup -Level INFO -Message "SAP under install removed"
			$CleanupTextBox.AppendText("`n")
			$cleanupTextBox.ScrollToCaret()
		}
		
		else
		{
			$CleanupTextBox.AppendText("SAP does not exist under install")
			Write-LogCleanup -Level INFO -Message "SAP under install removed"
			$CleanupTextBox.AppendText("`n")
			$cleanupTextBox.ScrollToCaret()
		}
		
		$PreINSTALLFolder = (Test-Path "$global:InstallDrive\Visma\install\Preinstall")
		
		if ($PreINSTALLFolder -eq $true)
		{
			Remove-Item -Path "$global:InstallDrive\Visma\install\PreInstall" -Recurse -Force -ErrorAction SilentlyContinue
			$CleanupTextBox.AppendText("Preinstall under install removed")
			Write-LogCleanup -Level INFO -Message "Preinstall under install removed"
			$CleanupTextBox.AppendText("`n")
			$cleanupTextBox.ScrollToCaret()
		}
		
		else
		{
			$CleanupTextBox.AppendText("Preinstall does not exist under install")
			Write-LogCleanup -Level INFO -Message "Preinstall does not exist under install"
			$CleanupTextBox.AppendText("`n")
			$cleanupTextBox.ScrollToCaret()
		}
		
		$MicrosoftFolder = (Test-Path "$global:InstallDrive\Visma\install\Microsoft")
		
		if ($MicrosoftFolder -eq $true)
		{
			Remove-Item -Path "$global:InstallDrive\Visma\install\Microsoft" -Recurse -Force -ErrorAction SilentlyContinue
			$CleanupTextBox.AppendText("Microsoft under install removed")
			Write-LogCleanup -Level INFO -Message "Micrsoft under install removed"
			$CleanupTextBox.AppendText("`n")
			$cleanupTextBox.ScrollToCaret()
		}
		
		else
		{
			$CleanupTextBox.AppendText("Microsoft does not exist under install")
			Write-LogCleanup -Level INFO -Message "Microsoft does not exist under install"
			$CleanupTextBox.AppendText("`n")
			$cleanupTextBox.ScrollToCaret()
		}
		
		
		
		Remove-PersonecFolders -Path "$global:InstallDrive\Visma\install\HRM"
		Remove-PersonecFolders -Path "$global:InstallDrive\Visma\install\FDN" -ExcludedFolders 'PIN'
	}
	else
	{
		# Update the text of the existing RichTextBox
		$CleanUpTextBox.Text = "Files not deleted."
		Write-Log -Level INFO -Message "ASP.NET Files not Deleted"
	}
	
	
	
	
}

