  <Code><![CDATA[
$QuickFixTools_Load={
	#TODO: Initialize Form Controls here
	If ($global:SelectedBigram -eq 'Select Bigram' -or $global:SelectedBackupfolder -eq 'Select Folder')
	{
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("You Need to select BIGRAM and BackupFolder")
		$richtextbox1.ScrollToCaret()
		$QuickFixTools.Close()
	}
	
	
	[XML]$xmlValuesVersion = Get-Content "$global:InstallDrive\Visma\install\backup\appsettings\VPBS.XML"
	
	$VPBSValue_1 = $xmlValuesVersion.Configuration.VPBS1
	$VPBSValue_2 = $xmlValuesVersion.Configuration.VPBS2
	
	$TB_VPBSVersion_1.Clear()
	$TB_VPBSVersion_1.AppendText($VPBSValue_1)
	
	$TB_VPBSVersion_2.Clear()
	$TB_VPBSVersion_2.AppendText($VPBSValue_2)
	
	Refresh-StatusBar
	
	$DisplayMode = Get-RegValue -RegPath 'HKLM:\SOFTWARE\Wow6432Node\Visma\TeliaCygate' -RegName DisplayModeScript
	
	if ($DisplayMode -eq 'Light')
	{
		Set-ControlTheme -Control $QuickFixTools -Theme Light
	}
	
	elseif ($DisplayMode -eq 'Dark')
	{
		Set-ControlTheme -Control $QuickFixTools -Theme Dark
	}
	
}



$buttonDownloadIISCrypto_Click={
	#TODO: Place custom script here
	
	$isscryptoDownloaded = (Test-Path "$global:InstallDrive\Visma\Install\IISCrypto.exe")
	
	if ($isscryptoDownloaded -eq $true)
	{
		$ToolTextbox.AppendText("`n")
		$ToolTextbox.AppendText("IISCrypto already downloaded")
		$ToolTextbox.ScrollToCaret()
	}
	
	else
	
	{
		$ToolTextbox.AppendText("`n")
		$ToolTextbox.AppendText("Start downloading IISCrypto")
		Invoke-WebRequest -Uri 'https://www.nartac.com/Downloads/IISCrypto/IISCrypto.exe' -OutFile "$global:InstallDrive\Visma\Install\IISCrypto.exe"
		$ToolTextbox.AppendText("`n")
		$ToolTextbox.AppendText("IISCrypto downloaded")
		$ToolTextbox.ScrollToCaret()
	}
}

$buttonTLS12Regfix_Click={
	#TODO: Place custom script here
	Set-RegistryKey -Path "HKLM:\SOFTWARE\Microsoft\.NETFramework\v4.0.30319" -Name 'SystemDefaultTlsVersions' -Type DWord -Value '00000001'
	Set-RegistryKey -Path "HKLM:\SOFTWARE\Wow6432Node\Microsoft\.NETFramework\v4.0.30319" -Name 'SystemDefaultTlsVersions' -Type DWord -Value '00000001'
	$ToolTextbox.AppendText("`n")
	$ToolTextbox.AppendText("TLS 1.2 regfix done!")
	Write-Log -Level INFO -Message "TLS 1.2 Regfix Done!"
}

$buttonDownloadVPBS_Click= {
	#TODO: Place custom script here
	
	$selectedBigram = $global:SelectedBigram
	$selectedBackupfolder = $global:SelectedBackupfolder
	
	$ToolTextbox.AppendText("`n")
	$ToolTextbox.AppendText("Starting download VPBS")
	[XML]$xmlValuesVersion = Get-Content "$global:InstallDrive\Visma\install\backup\appsettings\VPBS.XML"

	$VPBSValue_1 = $xmlValuesVersion.Configuration.VPBS1
	$VPBSValue_2 = $xmlValuesVersion.Configuration.VPBS2

	
	Write-Log -Level INFO -Message "VPBSversion from XML $VPBSValue"
	
	$zip = "VPBSDownload$VPBSValue_2.zip"
	
	Write-Log -Level INFO -Message "Start downloading $zip"
	
	Invoke-WebRequest -Uri "https://visma-pbs.s3.eu-central-1.amazonaws.com/$VPBSValue_1/$zip" -OutFile "$global:InstallDrive\visma\install\$zip" -Verbose
	$ToolTextbox.AppendText("`n")
	$ToolTextbox.AppendText("VPBS downloaded")
	Write-Log -Level INFO -Message "Finished downloading $zip"
	$ToolTextbox.AppendText("`n")
	$ToolTextbox.AppendText("Unblock VPBS zip file $zip")
	Write-Log -Level INFO -Message "Unblock VPBS zip file $zip"
	Unblock-File -Path "$global:InstallDrive\Visma\Install\$zip" -Verbose
	$ToolTextbox.AppendText("`n")
	$ToolTextbox.AppendText("Extracting Zip file to $global:InstallDrive\Visma\Install\VPBSDownload$VPBSValue_2")
	Write-Log -Level INFO -Message "Extracting Zip file to $global:InstallDrive\Visma\Install\VPBSDownload$VPBSValue_2"
	Expand-Archive -Path "$global:InstallDrive\Visma\Install\$zip" -DestinationPath "$global:InstallDrive\Visma\Install\VPBSDownload$VPBSValue_2\" -Verbose -force
	Write-Log -Level INFO -Message "Removing $zip"
	Remove-Item -Path "$global:InstallDrive\Visma\install\$zip" -Force
	
	$ToolTextbox.AppendText("`n")
	$ToolTextbox.AppendText("Finished with VPBS Download and unpacking")
	Write-Log -Level INFO -Message "Finished with VPBS Download and unpacking"
	$ToolTextbox.ScrollToCaret()
	}

$buttonClose_Click={
	#TODO: Place custom script here
	$QuickFixTools.Close()
}

$buttonResetWWWPUDPPPData_Click={
	#TODO: Place custom script here
	
	Add-Type -AssemblyName PresentationCore, PresentationFramework
	$ButtonType = [System.Windows.MessageBoxButton]::YesNo
	$MessageIcon = [System.Windows.MessageBoxImage]::Information
	$MessageBody = "Are you sure that you want to restore folder rights?"
	$MessageTitle = "Restore default folder rights"
	
	$Result = [System.Windows.MessageBox]::Show($MessageBody, $MessageTitle, $ButtonType, $MessageIcon)
	
	
	if ($Result -eq [System.Windows.MessageBoxResult]::Yes)
	{

		# Kör reset på wwwroot och undermappar till default
		icacls "$global:InstallDrive\Visma\Wwwroot" /reset /t /c /l
		$ToolTextbox.AppendText("`n")
		$ToolTextbox.AppendText("WWWroot and subfolders set to default")
		$ToolTextbox.ScrollToCaret()
		Write-Log -Level INFO -Message "WWWroot and subfolders set to default"
		
		#lägger till Network services och IIS_IUSR med modify
		icacls "$global:InstallDrive\Visma\Wwwroot\$global:SelectedBigram\PPP" /grant "NETWORK SERVICE:(OI)(CI)M" /grant "IIS_IUSRS:(OI)(CI)M" /t
		$ToolTextbox.AppendText("`n")
		$ToolTextbox.AppendText("Restored NETWORK SERVICE and IIS_IUSR on $global:InstallDrive\Visma\Wwwroot\$global:SelectedBigram\PPP")
		$ToolTextbox.ScrollToCaret()
		Write-Log -Level INFO -Message "Restored NETWORK SERVICE and IIS_IUSR on $global:InstallDrive\Visma\Wwwroot\$global:SelectedBigram\PPP"
		icacls "$global:InstallDrive\Visma\Wwwroot\$global:SelectedBigram\PUD" /grant "NETWORK SERVICE:(OI)(CI)M" /grant "IIS_IUSRS:(OI)(CI)M" /t
		$ToolTextbox.AppendText("`n")
		$ToolTextbox.AppendText("Restored NETWORK SERVICE and IIS_IUSR on $global:InstallDrive\Visma\Wwwroot\$global:SelectedBigram\PUD")
		$ToolTextbox.ScrollToCaret()
		Write-Log -Level INFO -Message "Restored NETWORK SERVICE and IIS_IUSR on $global:InstallDrive\Visma\Wwwroot\$global:SelectedBigram\PUD"
		
		if (Test-Path -Path "$global:InstallDrive\visma\wwwroot\ExtServices\$global:SelectedBigram\VismaExternalServices\Data")
		{
			icacls "$global:InstallDrive\visma\wwwroot\ExtServices\$global:SelectedBigram\VismaExternalServices\Data" /grant "NETWORK SERVICE:(OI)(CI)M" /grant "IIS_IUSRS:(OI)(CI)M" /t
			$ToolTextbox.AppendText("`n")
			$ToolTextbox.AppendText("Restored NETWORK SERVICE and IIS_IUSR on $global:InstallDrive\visma\wwwroot\ExtServices\$global:SelectedBigram\VismaExternalServices\Data")
			$ToolTextbox.ScrollToCaret()
			Write-Log -Level INFO -Message "Restored NETWORK SERVICE and IIS_IUSR on $global:InstallDrive\visma\wwwroot\ExtServices\$global:SelectedBigram\VismaExternalServices\Data"
			
		}
		
		$ToolTextbox.AppendText("`n")
		$ToolTextbox.AppendText("$global:InstallDrive\visma\wwwroot\ExtServices\$global:SelectedBigram\VismaExternalServices\Data does not exist")
		$ToolTextbox.ScrollToCaret()
		Write-Log -Level INFO -Message "$global:InstallDrive\visma\wwwroot\ExtServices\$global:SelectedBigram\VismaExternalServices\Data does not exist"
		
	}
	
	else
	{
		$ToolTextbox.AppendText("`n")
		$ToolTextbox.AppendText("Restore of default folder rights cancelled")
		$ToolTextbox.ScrollToCaret()
		Write-Log -Level INFO -Message "Restore of default folder rights cancelled"
	}
	
}

$buttonDecryptBackup_Click = {
	
	$ToolTextbox.AppendText("`n")
	$ToolTextbox.AppendText("Decrypting web.config appsettings ")
	$ToolTextbox.ScrollToCaret()
	
	# Define the path to aspnet_regiis.exe
	$AspNetRegIisLocation = "C:\Windows\Microsoft.NET\Framework\v4.0.30319\aspnet_regiis.exe"
	
	# Define the section to decrypt and the path to the web.config file
	$section = "appSettings"
	
	# Get the paths of all web.config files
	$AppPaths = Get-ChildItem -Path "$global:InstallDrive\Visma\Install\Backup\$global:SelectedBackupfolder\wwwroot" -Recurse -Filter web.config | Select-Object -ExpandProperty DirectoryName
	
	# Set up the progress bar
	$ToolsOverlay.Maximum = $AppPaths.Count
	$ToolsOverlay.Step = 1
	$ToolsOverlay.Value = 0
	
	foreach ($AppPath in $AppPaths)
	{
		# Run the decryption command
		& $AspNetRegIisLocation -pdf $section $AppPath
		$ToolsOverlay.PerformStep()
	}
	
	$ToolTextbox.AppendText("`n")
	$ToolTextbox.AppendText("Finished Decrypting web.config ")
	$ToolTextbox.ScrollToCaret()
	
}

$buttonEncryptBackup_Click = {
	
	$ToolTextbox.AppendText("`n")
	$ToolTextbox.AppendText("Encrypting web.config appsettings ")
	$ToolTextbox.ScrollToCaret()
	
	# Define the path to aspnet_regiis.exe
	$AspNetRegIisLocation = "C:\Windows\Microsoft.NET\Framework\v4.0.30319\aspnet_regiis.exe"
	
	# Define the section to encrypt and the path to the web.config file
	$section = "appSettings"
	
	# Get the paths of all web.config files
	$AppPaths = Get-ChildItem -Path "$global:InstallDrive\Visma\Install\Backup\$global:SelectedBackupfolder\wwwroot" -Recurse -Filter web.config | Select-Object -ExpandProperty DirectoryName
	
	# Set up the progress bar
	$ToolsOverlay.Maximum = $AppPaths.Count
	$ToolsOverlay.Step = 1
	$ToolsOverlay.Value = 0
	
	foreach ($AppPath in $AppPaths)
	{
		# Run the encryption command
		& $AspNetRegIisLocation -pef $section $AppPath
		$ToolsOverlay.PerformStep()
	}
	
	$ToolTextbox.AppendText("`n")
	$ToolTextbox.AppendText("Finished Encrypting web.config ")
	$ToolTextbox.ScrollToCaret()
}

