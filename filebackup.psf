  <Code><![CDATA[

$formFileBackup_Load={
	#TODO: Initialize Form Controls here
	Refresh-StatusBar
	
	$DisplayMode = Get-RegValue -RegPath 'HKLM:\SOFTWARE\Wow6432Node\Visma\TeliaCygate' -RegName DisplayModeScript
	
	if ($DisplayMode -eq 'Light')
	{
		Set-ControlTheme -Control $formFileBackup -Theme Light
	}
	
	elseif ($DisplayMode -eq 'Dark')
	{
		Set-ControlTheme -Control $formFileBackup -Theme Dark
	}
	
	If ($global:SelectedBigram -eq 'Select Bigram' -or $global:SelectedBackupfolder -eq 'Select Folder')
	{
		$richtextbox1.AppendText("`n")
		$richtextbox1.AppendText("You Need to select BIGRAM and BackupFolder")
		$richtextbox1.ScrollToCaret()
		$formFileBackup.Close()
	}
}


$buttonClose_Click={
	#TODO: Place custom script here
	$formFileBackup.Close()
}

$buttonFileBackup_Click={
	#TODO: Place custom script here
	$ProgressBarBackup.TextOverlay = 'Starting backup of programs...'
	$FilebackupWindow.AppendText("`n")
	$FilebackupWindow.AppendText("Starting backup of programs...")
	$FilebackupWindow.AppendText("`n")
	$FilebackupWindow.ScrollToCaret()
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("Starting backup of programs...")
	$richtextbox1.AppendText("`n")
	$richtextbox1.ScrollToCaret()
		
	$BackupFolder = $global:SelectedBackupfolder
	$InstallDrive = $global:InstallDrive
	
	Copy-WithProgress -Source "$InstallDrive\Visma\programs" -Destination "$InstallDrive\Visma\Install\Backup\$BackupFolder\Programs"
	$FilebackupWindow.AppendText("`n")
	$FilebackupWindow.AppendText("Ending backup of programs...         ")
	$FilebackupWindow.ScrollToCaret()
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("Ending backup of programs...         ")
	$richtextbox1.ScrollToCaret()
	
	$ProgressBarBackup.TextOverlay = 'Starting backup of wwwroot...'
	$FilebackupWindow.AppendText("`n")
	$FilebackupWindow.AppendText("Starting backup of wwwroot...")
	$FilebackupWindow.AppendText("`n")
	$FilebackupWindow.ScrollToCaret()
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("Starting backup of wwwroot...")
	$richtextbox1.AppendText("`n")
	$richtextbox1.ScrollToCaret()
	
	Copy-WithProgress -Source "$InstallDrive\Visma\wwwroot" -Destination "$InstallDrive\Visma\Install\Backup\$BackupFolder\wwwroot"
	$FilebackupWindow.AppendText("`n")
	$FilebackupWindow.AppendText("Ending backup of wwwroot...         ")
	$FilebackupWindow.AppendText("`n")
	$FilebackupWindow.ScrollToCaret()
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("Ending backup of wwwroot...         ")
	$richtextbox1.AppendText("`n")
	$richtextbox1.ScrollToCaret()
	
	Copy-WithProgress -Source "$InstallDrive\Visma\Install\FDN\PIN\Client\Base\SW" -Destination "$InstallDrive\Visma\Install\Backup\$BackupFolder\PINBackup"
	$FilebackupWindow.AppendText("`n")
	$FilebackupWindow.AppendText("Ending backup of PIN...         ")
	$FilebackupWindow.AppendText("`n")
	$FilebackupWindow.ScrollToCaret()
	$richtextbox1.AppendText("`n")
	$richtextbox1.AppendText("Ending backup of PIN...         ")
	$richtextbox1.AppendText("`n")
	$richtextbox1.ScrollToCaret()
	
	Check-FileSize -FilePath "$InstallDrive\Visma\install\backup\$global:SelectedBackupfolder\Robocopy.log" -MinSizeKB 500 -ErrorTitle 'ERROR' -ErrorText 'Something is not working, please check backup!' -SuccessTitle 'Success' -SuccessText 'Backup done!' -WarningTitle 'Warning' -WarningText 'Please check log and backup!'
	
	<##
	Add-Type -AssemblyName PresentationCore, PresentationFramework
	$ButtonType = [System.Windows.MessageBoxButton]::OK
	$MessageIcon = [System.Windows.MessageBoxImage]::Information
	$MessageBody = "Backup done!"
	$MessageTitle = "Backupstatus"
	
	$Result = [System.Windows.MessageBox]::Show($MessageBody, $MessageTitle, $ButtonType, $MessageIcon)
	##>
	

}
]]></Code>
