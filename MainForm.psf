	$openfiledialog1.ShowDialog()
	$logfile = $openfiledialog1.FileName
	$variable = Get-Content $logfile -Raw | ForEach-Object { "$_`r`n" }
	$richtextbox1.Clear()
	$richtextbox1.Lines = $variable
	$richtextbox1.ScrollToCaret()
}

